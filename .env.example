# GEMINI_API_KEY: Required for server-side Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Hosted application URL.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_MAPS_API_KEY: Scoped browser key for Google Maps Platform (@vis.gl/react-google-maps).
VITE_GOOGLE_MAPS_API_KEY=""

# Cloud SQL for PostgreSQL Runtime Environment Variables (injected automatically)
SQL_HOST=""
SQL_DB_NAME=""
SQL_USER=""
SQL_PASSWORD=""
SQL_ADMIN_USER=""
SQL_ADMIN_PASSWORD=""
