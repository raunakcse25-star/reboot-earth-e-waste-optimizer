rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isVerified() && (
        request.auth.token.email == 'raunaksahni7286@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidPreference(data) {
      return data.keys().hasAll(['userId', 'theme', 'language', 'emailAlerts', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'theme', 'language', 'emailAlerts', 'createdAt', 'updatedAt'])
        && isValidId(data.userId)
        && (data.userId == request.auth.uid || isAdmin())
        && data.theme is string && data.theme.size() <= 16 && data.theme in ['dark', 'light', 'system']
        && data.language is string && data.language.size() <= 16 && data.language in ['en', 'hi', 'hinglish']
        && data.emailAlerts is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll([
          'userId',
          'email',
          'fullName',
          'organizationName',
          'phone',
          'city',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'userId',
          'email',
          'fullName',
          'organizationName',
          'phone',
          'city',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.userId)
        && (data.userId == request.auth.uid || isAdmin())
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 120
        && data.organizationName is string && data.organizationName.size() <= 140
        && data.phone is string && data.phone.size() <= 40
        && data.city is string && data.city.size() <= 80
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidNotification(data) {
      return data.keys().hasAll(['userId', 'title', 'message', 'category', 'read', 'createdAt'])
        && data.keys().hasOnly(['userId', 'title', 'message', 'category', 'read', 'createdAt'])
        && isValidId(data.userId)
        && (data.userId == request.auth.uid || isAdmin())
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 140
        && data.message is string && data.message.size() >= 1 && data.message.size() <= 500
        && data.category is string && data.category.size() <= 32 && data.category in ['pickup', 'optimization', 'facility', 'system']
        && data.read is bool
        && data.createdAt is timestamp;
    }

    function isValidChatSession(data) {
      return data.keys().hasAll(['userId', 'title', 'language', 'messages', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'title', 'language', 'messages', 'createdAt', 'updatedAt'])
        && isValidId(data.userId)
        && (data.userId == request.auth.uid || isAdmin())
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 120
        && data.language is string && data.language.size() <= 16 && data.language in ['en', 'hi', 'hinglish']
        && data.messages is list && data.messages.size() <= 40
        && (data.messages.size() == 0 || data.messages[0] is map)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidFacilityReview(data) {
      return data.keys().hasAll([
          'facilityId',
          'facilityName',
          'userId',
          'authorName',
          'rating',
          'comment',
          'visibility',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'facilityId',
          'facilityName',
          'userId',
          'authorName',
          'rating',
          'comment',
          'visibility',
          'createdAt',
          'updatedAt'
        ])
        && data.facilityId is int && data.facilityId >= 1 && data.facilityId <= 1000000
        && data.facilityName is string && data.facilityName.size() >= 1 && data.facilityName.size() <= 140
        && isValidId(data.userId)
        && (data.userId == request.auth.uid || isAdmin())
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80
        && data.rating is int && data.rating >= 1 && data.rating <= 5
        && data.comment is string && data.comment.size() >= 3 && data.comment.size() <= 600
        && data.visibility is string && data.visibility.size() <= 16 && data.visibility == 'public'
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidScheduledPickup(data) {
      return data.keys().hasAll([
          'userId',
          'requestCode',
          'deviceName',
          'category',
          'quantity',
          'estimatedWeightKg',
          'condition',
          'pickupAddress',
          'lat',
          'lng',
          'preferredDate',
          'timeSlot',
          'contactName',
          'contactPhone',
          'instructions',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'userId',
          'requestCode',
          'deviceName',
          'category',
          'quantity',
          'estimatedWeightKg',
          'condition',
          'pickupAddress',
          'lat',
          'lng',
          'preferredDate',
          'timeSlot',
          'contactName',
          'contactPhone',
          'instructions',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.userId)
        && (data.userId == request.auth.uid || isAdmin())
        && data.requestCode is string && data.requestCode.size() >= 4 && data.requestCode.size() <= 32 && data.requestCode.matches('^[A-Z0-9\\-]+$')
        && data.deviceName is string && data.deviceName.size() >= 2 && data.deviceName.size() <= 140
        && data.category is string && data.category.size() >= 2 && data.category.size() <= 60
        && data.quantity is int && data.quantity >= 1 && data.quantity <= 5000
        && data.estimatedWeightKg is number && data.estimatedWeightKg >= 0.1 && data.estimatedWeightKg <= 50000
        && data.condition is string && data.condition.size() >= 2 && data.condition.size() <= 60
        && data.pickupAddress is string && data.pickupAddress.size() >= 5 && data.pickupAddress.size() <= 300
        && data.lat is number && data.lat >= -90 && data.lat <= 90
        && data.lng is number && data.lng >= -180 && data.lng <= 180
        && data.preferredDate is string && data.preferredDate.size() == 10 && data.preferredDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.timeSlot is string && data.timeSlot.size() <= 32 && data.timeSlot in [
          '09:00 AM - 12:00 PM',
          '10:00 AM - 01:00 PM',
          '02:00 PM - 05:00 PM',
          '05:00 PM - 08:00 PM'
        ]
        && data.contactName is string && data.contactName.size() >= 2 && data.contactName.size() <= 120
        && data.contactPhone is string && data.contactPhone.size() >= 6 && data.contactPhone.size() <= 40
        && data.instructions is string && data.instructions.size() <= 500
        && data.status is string && data.status.size() <= 32 && data.status in [
          'Submitted',
          'Under Review',
          'Approved',
          'Scheduled',
          'Transporter Assigned',
          'Collected',
          'Received at Facility',
          'Processing',
          'Completed',
          'Cancelled'
        ]
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidOptimizationRun(data) {
      return data.keys().hasAll([
          'userId',
          'runCode',
          'objective',
          'totalDistanceKm',
          'estimatedTravelMinutes',
          'estimatedCostInr',
          'estimatedEmissionsKg',
          'assignedCount',
          'unassignedCount',
          'approved',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'userId',
          'runCode',
          'objective',
          'totalDistanceKm',
          'estimatedTravelMinutes',
          'estimatedCostInr',
          'estimatedEmissionsKg',
          'assignedCount',
          'unassignedCount',
          'approved',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.userId)
        && (data.userId == request.auth.uid || isAdmin())
        && data.runCode is string && data.runCode.size() >= 4 && data.runCode.size() <= 32 && data.runCode.matches('^[A-Z0-9\\-]+$')
        && data.objective is string && data.objective.size() <= 16 && data.objective in ['emission', 'distance', 'cost']
        && data.totalDistanceKm is number && data.totalDistanceKm >= 0 && data.totalDistanceKm <= 500000
        && data.estimatedTravelMinutes is int && data.estimatedTravelMinutes >= 0 && data.estimatedTravelMinutes <= 100000
        && data.estimatedCostInr is number && data.estimatedCostInr >= 0 && data.estimatedCostInr <= 100000000
        && data.estimatedEmissionsKg is number && data.estimatedEmissionsKg >= 0 && data.estimatedEmissionsKg <= 500000
        && data.assignedCount is int && data.assignedCount >= 0 && data.assignedCount <= 10000
        && data.unassignedCount is int && data.unassignedCount >= 0 && data.unassignedCount <= 10000
        && data.approved is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidInventoryBatch(data) {
      return data.keys().hasAll([
          'userId',
          'batchCode',
          'facilityId',
          'category',
          'deviceSummary',
          'quantity',
          'weightKg',
          'storageZone',
          'status',
          'processingStage',
          'recoveredCopperKg',
          'recoveredAluminumKg',
          'recoveredPlasticsKg',
          'recoveredPreciousGrams',
          'reusableUnits',
          'residueKg',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'userId',
          'batchCode',
          'facilityId',
          'category',
          'deviceSummary',
          'quantity',
          'weightKg',
          'storageZone',
          'status',
          'processingStage',
          'recoveredCopperKg',
          'recoveredAluminumKg',
          'recoveredPlasticsKg',
          'recoveredPreciousGrams',
          'reusableUnits',
          'residueKg',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.userId)
        && (data.userId == request.auth.uid || isAdmin())
        && data.batchCode is string && data.batchCode.size() >= 4 && data.batchCode.size() <= 32 && data.batchCode.matches('^[A-Z0-9\\-]+$')
        && data.facilityId is int && data.facilityId >= 1 && data.facilityId <= 1000000
        && data.category is string && data.category.size() >= 2 && data.category.size() <= 60
        && data.deviceSummary is string && data.deviceSummary.size() >= 2 && data.deviceSummary.size() <= 200
        && data.quantity is int && data.quantity >= 1 && data.quantity <= 100000
        && data.weightKg is number && data.weightKg >= 0.1 && data.weightKg <= 1000000
        && data.storageZone is string && data.storageZone.size() >= 1 && data.storageZone.size() <= 60
        && data.status is string && data.status.size() <= 32 && data.status in [
          'Received',
          'In Processing',
          'Inspected',
          'Dismantling',
          'Refurbished',
          'Recycled',
          'Completed',
          'Dispatched'
        ]
        && data.processingStage is string && data.processingStage.size() <= 32 && data.processingStage in [
          'Inspection',
          'Dismantling',
          'Refurbishment',
          'Material Recovery',
          'Recycled'
        ]
        && data.recoveredCopperKg is number && data.recoveredCopperKg >= 0 && data.recoveredCopperKg <= 1000000
        && data.recoveredAluminumKg is number && data.recoveredAluminumKg >= 0 && data.recoveredAluminumKg <= 1000000
        && data.recoveredPlasticsKg is number && data.recoveredPlasticsKg >= 0 && data.recoveredPlasticsKg <= 1000000
        && data.recoveredPreciousGrams is number && data.recoveredPreciousGrams >= 0 && data.recoveredPreciousGrams <= 1000000
        && data.reusableUnits is int && data.reusableUnits >= 0 && data.reusableUnits <= 100000
        && data.residueKg is number && data.residueKg >= 0 && data.residueKg <= 1000000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSupportTicket(data) {
      return data.keys().hasAll([
          'userId',
          'name',
          'email',
          'category',
          'subject',
          'message',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'userId',
          'name',
          'email',
          'category',
          'subject',
          'message',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.userId)
        && (data.userId == request.auth.uid || isAdmin())
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && data.category is string && data.category.size() >= 2 && data.category.size() <= 60
        && data.subject is string && data.subject.size() >= 2 && data.subject.size() <= 160
        && data.message is string && data.message.size() >= 5 && data.message.size() <= 1500
        && data.status is string && data.status.size() <= 24 && data.status in ['Open', 'In Progress', 'Resolved', 'Closed']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Connection probe path (read-only ping)
    match /test/connection {
      allow get: if true;
    }

    // Admin registry (only verified admins can read/manage)
    match /admins/{adminUid} {
      allow get: if isValidId(adminUid) && isAdmin();
      allow create, update, delete: if isValidId(adminUid) && isAdmin();
    }

    // Per-user UI preferences
    match /userPreferences/{userId} {
      allow get: if isValidId(userId) && isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isValidId(userId)
        && isVerified()
        && request.auth.uid == userId
        && isValidPreference(incoming())
        && incoming().userId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isVerified()
        && isValidPreference(incoming())
        && (
          isAdmin() || (
            request.auth.uid == userId
            && incoming().userId == existing().userId
            && incoming().createdAt == existing().createdAt
            && incoming().updatedAt == request.time
            && incoming().diff(existing()).affectedKeys().hasOnly(['theme', 'language', 'emailAlerts', 'updatedAt'])
          )
        );
      allow delete: if isValidId(userId) && isVerified() && (request.auth.uid == userId || isAdmin());
    }

    // Private owner-scoped user profiles (strict PII isolation)
    match /userProfiles/{userId} {
      allow get: if isValidId(userId) && isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isValidId(userId)
        && isVerified()
        && request.auth.uid == userId
        && isValidUserProfile(incoming())
        && incoming().userId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isVerified()
        && isValidUserProfile(incoming())
        && (
          isAdmin() || (
            request.auth.uid == userId
            && incoming().userId == existing().userId
            && incoming().email == existing().email
            && incoming().createdAt == existing().createdAt
            && incoming().updatedAt == request.time
            && incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'organizationName', 'phone', 'city', 'updatedAt'])
          )
        );
      allow delete: if isValidId(userId) && isVerified() && (request.auth.uid == userId || isAdmin());
    }

    // Real-time operational notifications
    match /notifications/{notificationId} {
      allow get: if isValidId(notificationId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isValidId(notificationId)
        && isVerified()
        && isValidNotification(incoming())
        && incoming().createdAt == request.time;
      allow update: if isValidId(notificationId)
        && isVerified()
        && isValidNotification(incoming())
        && (
          isAdmin() || (
            existing().userId == request.auth.uid
            && incoming().userId == existing().userId
            && incoming().createdAt == existing().createdAt
            && incoming().diff(existing()).affectedKeys().hasOnly(['read'])
          )
        );
      allow delete: if isValidId(notificationId) && isVerified() && (existing().userId == request.auth.uid || isAdmin());
    }

    // EcoBot AI chat sessions
    match /chatSessions/{sessionId} {
      allow get: if isValidId(sessionId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isValidId(sessionId)
        && isVerified()
        && isValidChatSession(incoming())
        && incoming().userId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(sessionId)
        && isVerified()
        && isValidChatSession(incoming())
        && (
          isAdmin() || (
            existing().userId == request.auth.uid
            && incoming().userId == existing().userId
            && incoming().createdAt == existing().createdAt
            && incoming().updatedAt == request.time
            && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'language', 'messages', 'updatedAt'])
          )
        );
      allow delete: if isValidId(sessionId) && isVerified() && (existing().userId == request.auth.uid || isAdmin());
    }

    // Community ratings and reviews for verified collection centres (zero PII)
    match /facilityReviews/{reviewId} {
      allow get: if isValidId(reviewId) && (
        existing().visibility == 'public' ||
        (isSignedIn() && (existing().userId == request.auth.uid || isAdmin()))
      );
      allow list: if resource.data.visibility == 'public';
      allow create: if isValidId(reviewId)
        && isVerified()
        && isValidFacilityReview(incoming())
        && incoming().userId == request.auth.uid
        && reviewId == ('rev_f' + string(incoming().facilityId) + '_' + request.auth.uid)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(reviewId)
        && isVerified()
        && isValidFacilityReview(incoming())
        && (
          isAdmin() || (
            existing().userId == request.auth.uid
            && incoming().userId == existing().userId
            && incoming().facilityId == existing().facilityId
            && incoming().facilityName == existing().facilityName
            && incoming().visibility == existing().visibility
            && incoming().createdAt == existing().createdAt
            && incoming().updatedAt == request.time
            && incoming().diff(existing()).affectedKeys().hasOnly(['authorName', 'rating', 'comment', 'updatedAt'])
          )
        );
      allow delete: if isValidId(reviewId)
        && isVerified()
        && (existing().userId == request.auth.uid || isAdmin());
    }

    // Authenticated user e-waste collection time-slot bookings (strict PII isolation)
    match /scheduledPickups/{bookingId} {
      allow get: if isValidId(bookingId)
        && isSignedIn()
        && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isValidId(bookingId)
        && isVerified()
        && isValidScheduledPickup(incoming())
        && incoming().userId == request.auth.uid
        && incoming().status == 'Submitted'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(bookingId)
        && isVerified()
        && isValidScheduledPickup(incoming())
        && (
          isAdmin() || (
            existing().userId == request.auth.uid
            && existing().status != 'Completed'
            && existing().status != 'Cancelled'
            && incoming().userId == existing().userId
            && incoming().requestCode == existing().requestCode
            && incoming().createdAt == existing().createdAt
            && incoming().updatedAt == request.time
            && (
              (
                incoming().status == existing().status
                && incoming().diff(existing()).affectedKeys().hasOnly(['preferredDate', 'timeSlot', 'instructions', 'updatedAt'])
              ) || (
                incoming().status == 'Cancelled'
                && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
              )
            )
          )
        );
      allow delete: if isValidId(bookingId) && isVerified() && isAdmin();
    }

    // Authenticated user route optimization runs (owner-scoped history)
    match /optimizationRuns/{runId} {
      allow get: if isValidId(runId)
        && isSignedIn()
        && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isValidId(runId)
        && isVerified()
        && isValidOptimizationRun(incoming())
        && incoming().userId == request.auth.uid
        && incoming().approved == false
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(runId)
        && isVerified()
        && isValidOptimizationRun(incoming())
        && isAdmin()
        && incoming().userId == existing().userId
        && incoming().runCode == existing().runCode
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if isValidId(runId)
        && isVerified()
        && (existing().userId == request.auth.uid || isAdmin());
    }

    // Operator-scoped facility inventory & material recovery batches
    match /inventoryBatches/{batchId} {
      allow get: if isValidId(batchId)
        && isSignedIn()
        && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isValidId(batchId)
        && isVerified()
        && isValidInventoryBatch(incoming())
        && incoming().userId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(batchId)
        && isVerified()
        && isValidInventoryBatch(incoming())
        && (
          isAdmin() || (
            existing().userId == request.auth.uid
            && incoming().userId == existing().userId
            && incoming().batchCode == existing().batchCode
            && incoming().createdAt == existing().createdAt
            && incoming().updatedAt == request.time
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'storageZone',
              'status',
              'processingStage',
              'recoveredCopperKg',
              'recoveredAluminumKg',
              'recoveredPlasticsKg',
              'recoveredPreciousGrams',
              'reusableUnits',
              'residueKg',
              'updatedAt'
            ])
          )
        );
      allow delete: if isValidId(batchId)
        && isVerified()
        && (existing().userId == request.auth.uid || isAdmin());
    }

    // Owner-scoped support inquiries (strict PII isolation)
    match /supportTickets/{ticketId} {
      allow get: if isValidId(ticketId)
        && isSignedIn()
        && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isValidId(ticketId)
        && isVerified()
        && isValidSupportTicket(incoming())
        && incoming().userId == request.auth.uid
        && incoming().status == 'Open'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(ticketId)
        && isVerified()
        && isValidSupportTicket(incoming())
        && isAdmin()
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if isValidId(ticketId) && isVerified() && isAdmin();
    }
  }
}
