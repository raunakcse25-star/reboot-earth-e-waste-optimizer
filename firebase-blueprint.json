{
  "entities": {
    "UserPreference": {
      "title": "UserPreference",
      "description": "User UI theme, language, and notification settings stored per authenticated user.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "theme": {
          "type": "string",
          "enum": ["dark", "light", "system"],
          "maxLength": 16
        },
        "language": {
          "type": "string",
          "enum": ["en", "hi", "hinglish"],
          "maxLength": 16
        },
        "emailAlerts": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "theme", "language", "emailAlerts", "createdAt", "updatedAt"]
    },
    "NotificationItem": {
      "title": "NotificationItem",
      "description": "Real-time operational notifications for pickup updates, optimization alerts, and role approvals.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "maxLength": 140
        },
        "message": {
          "type": "string",
          "maxLength": 500
        },
        "category": {
          "type": "string",
          "enum": ["pickup", "optimization", "facility", "goal", "market", "system"],
          "maxLength": 32
        },
        "read": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "title", "message", "category", "read", "createdAt"]
    },
    "ChatSession": {
      "title": "ChatSession",
      "description": "EcoBot conversation history for an authenticated user.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "maxLength": 120
        },
        "language": {
          "type": "string",
          "enum": ["en", "hi", "hinglish"],
          "maxLength": 16
        },
        "messages": {
          "type": "array",
