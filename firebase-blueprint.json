        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160
        },
        "fullName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "organizationName": {
          "type": "string",
          "maxLength": 140
