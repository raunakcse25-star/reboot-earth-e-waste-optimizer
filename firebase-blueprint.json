    "MarketPriceAlert": {
      "title": "MarketPriceAlert",
      "description": "User-defined e-waste buy-back market price threshold alert for triggering push notifications.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "categoryId": {
          "type": "string",
          "enum": [
            "gold_pcb",
            "ram_cpu",
            "smartphone_boards",
            "laptop_boards",
            "copper_cables",
            "li_ion_batteries",
            "power_supplies",
            "solar_pv_cells"
          ],
          "maxLength": 32
        },
        "categoryName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "condition": {
          "type": "string",
          "enum": ["above", "below"],
          "maxLength": 16
        },
        "targetPriceInr": {
          "type": "number",
          "description": "Target buy-back threshold price in INR per kg (10 to 100000)."
        },
        "active": {
          "type": "boolean"
        },
        "browserPushEnabled": {
          "type": "boolean"
        },
        "lastTriggeredPriceInr": {
          "type": "number",
          "description": "Most recent spot buy-back price that triggered this alert (0 if never triggered)."
        },
        "triggeredCount": {
          "type": "integer",
          "description": "Number of times this threshold alert has fired (0 to 10000)."
        },
        "note": {
