        "ownerName",
        "title",
        "componentCategory",
        "listingType",
        "condition",
        "quantity",
        "estimatedWeightKg",
        "salvagedFrom",
        "tradePreference",
        "description",
        "city",
        "handoffMethod",
        "status",
        "visibility",
        "claimedByUid",
        "claimedByName",
        "createdAt",
        "updatedAt"
      ]
    },
