{
  "entities": {
    "UserPreference": {
      "title": "UserPreference",
      "description": "User UI theme, language, and notification settings stored per authenticated user.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "theme": {
          "type": "string",
          "enum": ["dark", "light", "system"],
          "maxLength": 16
        },
        "language": {
          "type": "string",
          "enum": ["en", "hi", "hinglish"],
          "maxLength": 16
        },
        "emailAlerts": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "theme", "language", "emailAlerts", "createdAt", "updatedAt"]
    },
    "NotificationItem": {
      "title": "NotificationItem",
      "description": "Real-time operational notifications for pickup updates, optimization alerts, and role approvals.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "maxLength": 140
        },
        "message": {
          "type": "string",
          "maxLength": 500
        },
        "category": {
          "type": "string",
          "enum": ["pickup", "optimization", "facility", "goal", "system"],
          "maxLength": 32
        },
        "read": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "title", "message", "category", "read", "createdAt"]
    },
    "ChatSession": {
      "title": "ChatSession",
      "description": "EcoBot conversation history for an authenticated user.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "maxLength": 120
        },
        "language": {
          "type": "string",
          "enum": ["en", "hi", "hinglish"],
          "maxLength": 16
        },
        "messages": {
          "type": "array",
          "description": "Bounded list of recent chat turns (max 40)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "title", "language", "messages", "createdAt", "updatedAt"]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Trusted admin allowlist document keyed by Firebase Auth UID.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "grantedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "grantedAt"]
    },
    "FacilityReview": {
      "title": "FacilityReview",
      "description": "Community 5-star rating and review submitted by an authenticated user for a verified collection centre.",
      "type": "object",
      "properties": {
        "facilityId": {
          "type": "integer",
          "description": "Numeric identifier of the verified collection centre."
        },
        "facilityName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        },
        "userId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "authorName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "rating": {
          "type": "integer",
          "description": "Integer star rating from 1 to 5."
        },
        "comment": {
          "type": "string",
          "minLength": 3,
          "maxLength": 600
        },
        "visibility": {
          "type": "string",
          "enum": ["public"],
          "maxLength": 16
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "facilityId",
        "facilityName",
        "userId",
        "authorName",
        "rating",
        "comment",
        "visibility",
        "createdAt",
        "updatedAt"
      ]
    },
    "ScheduledPickup": {
      "title": "ScheduledPickup",
      "description": "Time-slot booked e-waste collection request tied to an authenticated user's location.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "requestCode": {
          "type": "string",
          "minLength": 4,
          "maxLength": 32,
          "pattern": "^[A-Z0-9\\-]+$"
        },
        "deviceName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 140
        },
        "category": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60
        },
        "quantity": {
          "type": "integer",
          "description": "Number of electronic units scheduled for pickup (1 to 5000)."
        },
        "estimatedWeightKg": {
          "type": "number",
          "description": "Estimated total e-waste mass in kilograms (0.1 to 50000)."
        },
        "condition": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60
        },
        "pickupAddress": {
          "type": "string",
          "minLength": 5,
          "maxLength": 300
        },
        "lat": {
          "type": "number",
          "description": "Pickup location latitude (-90 to 90)."
        },
        "lng": {
          "type": "number",
          "description": "Pickup location longitude (-180 to 180)."
        },
        "preferredDate": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "timeSlot": {
          "type": "string",
          "enum": [
            "09:00 AM - 12:00 PM",
            "10:00 AM - 01:00 PM",
            "02:00 PM - 05:00 PM",
            "05:00 PM - 08:00 PM"
          ],
          "maxLength": 32
        },
        "contactName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "contactPhone": {
          "type": "string",
          "minLength": 6,
          "maxLength": 40
        },
        "instructions": {
          "type": "string",
          "maxLength": 500
        },
        "status": {
          "type": "string",
          "enum": [
            "Submitted",
            "Under Review",
            "Approved",
            "Scheduled",
            "Transporter Assigned",
            "Collected",
            "Received at Facility",
            "Processing",
            "Completed",
            "Cancelled"
          ],
          "maxLength": 32
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "userId",
        "requestCode",
        "deviceName",
        "category",
        "quantity",
        "estimatedWeightKg",
        "condition",
        "pickupAddress",
        "lat",
        "lng",
        "preferredDate",
        "timeSlot",
        "contactName",
        "contactPhone",
        "instructions",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private authenticated user profile synced across sessions and devices (strict owner/admin PII isolation; never stores client-editable RBAC roles).",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160
        },
        "fullName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "organizationName": {
          "type": "string",
          "maxLength": 140
        },
        "organizationType": {
          "type": "string",
          "enum": [
            "individual",
            "corporate",
            "educational",
            "government",
            "healthcare",
            "retail_oem",
            "recycler_partner",
            "ngo_community"
          ],
          "maxLength": 32
        },
        "phone": {
          "type": "string",
          "maxLength": 40
        },
        "city": {
          "type": "string",
          "maxLength": 80
        },
        "preferredChannel": {
          "type": "string",
          "enum": ["email", "sms", "whatsapp", "in_app"],
          "maxLength": 16
        },
        "emailAlerts": {
          "type": "boolean"
        },
        "pickupReminders": {
          "type": "boolean"
        },
        "goalMilestoneAlerts": {
          "type": "boolean"
        },
        "weeklyImpactDigest": {
          "type": "boolean"
        },
        "regulatoryUpdates": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "userId",
        "email",
        "fullName",
        "organizationName",
        "phone",
        "city",
        "createdAt",
        "updatedAt"
      ]
    },
    "OptimizationRun": {
      "title": "OptimizationRun",
      "description": "Persisted multi-objective e-waste route optimization calculation run owned by an authenticated user.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "runCode": {
          "type": "string",
          "minLength": 4,
          "maxLength": 32,
          "pattern": "^[A-Z0-9\\-]+$"
        },
        "objective": {
          "type": "string",
          "enum": ["emission", "distance", "cost"],
          "maxLength": 16
        },
        "totalDistanceKm": {
          "type": "number"
        },
        "estimatedTravelMinutes": {
          "type": "integer"
        },
        "estimatedCostInr": {
          "type": "number"
        },
        "estimatedEmissionsKg": {
          "type": "number"
        },
        "assignedCount": {
          "type": "integer"
        },
        "unassignedCount": {
          "type": "integer"
        },
        "approved": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "userId",
        "runCode",
        "objective",
        "totalDistanceKm",
        "estimatedTravelMinutes",
        "estimatedCostInr",
        "estimatedEmissionsKg",
        "assignedCount",
        "unassignedCount",
        "approved",
        "createdAt",
        "updatedAt"
      ]
    },
    "InventoryBatch": {
      "title": "InventoryBatch",
      "description": "Facility material recovery and dismantling batch logged by an authenticated operator.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "batchCode": {
          "type": "string",
          "minLength": 4,
          "maxLength": 32,
          "pattern": "^[A-Z0-9\\-]+$"
        },
        "facilityId": {
          "type": "integer"
        },
        "category": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60
        },
        "deviceSummary": {
          "type": "string",
          "minLength": 2,
          "maxLength": 200
        },
        "quantity": {
          "type": "integer"
        },
        "weightKg": {
          "type": "number"
        },
        "storageZone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "status": {
          "type": "string",
          "enum": ["Received", "In Processing", "Inspected", "Dismantling", "Refurbished", "Recycled", "Completed", "Dispatched"],
          "maxLength": 32
        },
        "processingStage": {
          "type": "string",
          "enum": ["Inspection", "Dismantling", "Refurbishment", "Material Recovery", "Recycled"],
          "maxLength": 32
        },
        "recoveredCopperKg": {
          "type": "number"
        },
        "recoveredAluminumKg": {
          "type": "number"
        },
        "recoveredPlasticsKg": {
          "type": "number"
        },
        "recoveredPreciousGrams": {
          "type": "number"
        },
        "reusableUnits": {
          "type": "integer"
        },
        "residueKg": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "userId",
        "batchCode",
        "facilityId",
        "category",
        "deviceSummary",
        "quantity",
        "weightKg",
        "storageZone",
        "status",
        "processingStage",
        "recoveredCopperKg",
        "recoveredAluminumKg",
        "recoveredPlasticsKg",
        "recoveredPreciousGrams",
        "reusableUnits",
        "residueKg",
        "createdAt",
        "updatedAt"
      ]
    },
    "SupportTicket": {
      "title": "SupportTicket",
      "description": "Owner-scoped customer support inquiry logged by an authenticated user.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160
        },
        "category": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60
        },
        "subject": {
          "type": "string",
          "minLength": 2,
          "maxLength": 160
        },
        "message": {
          "type": "string",
          "minLength": 5,
          "maxLength": 1500
        },
        "status": {
          "type": "string",
          "enum": ["Open", "In Progress", "Resolved", "Closed"],
          "maxLength": 24
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "userId",
        "name",
        "email",
        "category",
        "subject",
        "message",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "MonthlyRecyclingTarget": {
      "title": "MonthlyRecyclingTarget",
      "description": "User-defined monthly recycling goals (e-waste mass, CO2 avoided, and completed pickups) with milestone notification tracking.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "monthKey": {
          "type": "string",
          "minLength": 7,
          "maxLength": 7,
          "pattern": "^[0-9]{4}-[0-9]{2}$"
        },
        "targetWeightKg": {
          "type": "number",
          "description": "Monthly e-waste recycling weight target in kilograms (1 to 50000)."
        },
        "targetCo2Kg": {
          "type": "number",
          "description": "Monthly CO2e avoided target in kilograms (1 to 100000)."
        },
        "targetPickups": {
          "type": "integer",
          "description": "Monthly completed pickups or drop-offs target (1 to 500)."
        },
        "loggedBonusWeightKg": {
          "type": "number",
          "description": "Additional self-logged verified drop-off weight in kilograms (0 to 50000)."
        },
        "notifiedMilestones": {
          "type": "array",
          "description": "Bounded list of milestone IDs already notified for this month (max 12)."
        },
        "notes": {
          "type": "string",
          "maxLength": 300
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "userId",
        "monthKey",
        "targetWeightKg",
        "targetCo2Kg",
        "targetPickups",
        "loggedBonusWeightKg",
        "notifiedMilestones",
        "notes",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/userPreferences/{userId}": {
      "schema": { "$ref": "#/entities/UserPreference" },
      "description": "Per-user UI preferences (theme, language, alerts)."
    },
    "/userProfiles/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Owner-scoped persistent user profile metadata (strict PII isolation)."
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/NotificationItem" },
      "description": "Real-time user notifications."
    },
    "/chatSessions/{sessionId}": {
      "schema": { "$ref": "#/entities/ChatSession" },
      "description": "EcoBot AI assistant chat histories."
    },
    "/admins/{adminUid}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Admin role membership records."
    },
    "/facilityReviews/{reviewId}": {
      "schema": { "$ref": "#/entities/FacilityReview" },
      "description": "Public community ratings and reviews for verified collection centres."
    },
    "/scheduledPickups/{bookingId}": {
      "schema": { "$ref": "#/entities/ScheduledPickup" },
      "description": "Authenticated user e-waste collection time-slot bookings (strict owner/admin PII access)."
    },
    "/optimizationRuns/{runId}": {
      "schema": { "$ref": "#/entities/OptimizationRun" },
      "description": "Authenticated user route optimization run history."
    },
    "/inventoryBatches/{batchId}": {
      "schema": { "$ref": "#/entities/InventoryBatch" },
      "description": "Operator-scoped material recovery and processing batches."
    },
    "/supportTickets/{ticketId}": {
      "schema": { "$ref": "#/entities/SupportTicket" },
      "description": "Owner-scoped support inquiries (strict owner/admin PII access)."
    },
    "/recyclingTargets/{targetId}": {
      "schema": { "$ref": "#/entities/MonthlyRecyclingTarget" },
      "description": "Owner-scoped monthly recycling targets and progress milestone tracking."
    }
  }
}
