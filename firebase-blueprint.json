        "emailAlerts": {
          "type": "boolean"
        },
        "pickupReminders": {
          "type": "boolean"
        },
        "goalMilestoneAlerts": {
          "type": "boolean"
        },
        "weeklyImpactDigest": {
          "type": "boolean"
        },
        "regulatoryUpdates": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "userId",
        "email",
        "fullName",
        "organizationName",
        "phone",
        "city",
        "createdAt",
        "updatedAt"
      ]
    },
    "OptimizationRun": {
      "title": "OptimizationRun",
