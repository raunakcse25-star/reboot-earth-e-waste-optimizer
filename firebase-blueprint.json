{
  "entities": {
    "UserPreference": {
      "title": "UserPreference",
      "description": "User UI theme, language, and notification settings stored per authenticated user.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "theme": {
          "type": "string",
          "enum": ["dark", "light", "system"],
          "maxLength": 16
        },
        "language": {
          "type": "string",
          "enum": ["en", "hi", "hinglish"],
          "maxLength": 16
        },
        "emailAlerts": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "theme", "language", "emailAlerts", "createdAt", "updatedAt"]
    },
    "NotificationItem": {
      "title": "NotificationItem",
      "description": "Real-time operational notifications for pickup updates, optimization alerts, and role approvals.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "maxLength": 140
        },
        "message": {
          "type": "string",
          "maxLength": 500
        },
        "category": {
          "type": "string",
          "enum": ["pickup", "optimization", "facility", "system"],
          "maxLength": 32
        },
        "read": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "title", "message", "category", "read", "createdAt"]
    },
    "ChatSession": {
      "title": "ChatSession",
      "description": "EcoBot conversation history for an authenticated user.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "maxLength": 120
        },
        "language": {
          "type": "string",
          "enum": ["en", "hi", "hinglish"],
          "maxLength": 16
        },
        "messages": {
          "type": "array",
          "description": "Bounded list of recent chat turns (max 40)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "title", "language", "messages", "createdAt", "updatedAt"]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Trusted admin allowlist document keyed by Firebase Auth UID.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "grantedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "grantedAt"]
    },
    "FacilityReview": {
      "title": "FacilityReview",
      "description": "Community 5-star rating and review submitted by an authenticated user for a verified collection centre.",
      "type": "object",
      "properties": {
        "facilityId": {
          "type": "integer",
          "description": "Numeric identifier of the verified collection centre."
        },
        "facilityName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        },
        "userId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "authorName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "rating": {
          "type": "integer",
          "description": "Integer star rating from 1 to 5."
        },
        "comment": {
          "type": "string",
          "minLength": 3,
          "maxLength": 600
        },
        "visibility": {
          "type": "string",
          "enum": ["public"],
          "maxLength": 16
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "facilityId",
        "facilityName",
        "userId",
        "authorName",
        "rating",
        "comment",
        "visibility",
        "createdAt",
        "updatedAt"
      ]
    },
    "ScheduledPickup": {
      "title": "ScheduledPickup",
      "description": "Time-slot booked e-waste collection request tied to an authenticated user's location.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "requestCode": {
          "type": "string",
          "minLength": 4,
          "maxLength": 32,
          "pattern": "^[A-Z0-9\\-]+$"
        },
        "deviceName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 140
        },
        "category": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60
        },
        "quantity": {
          "type": "integer",
          "description": "Number of electronic units scheduled for pickup (1 to 5000)."
        },
        "estimatedWeightKg": {
          "type": "number",
          "description": "Estimated total e-waste mass in kilograms (0.1 to 50000)."
        },
        "condition": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60
        },
        "pickupAddress": {
          "type": "string",
          "minLength": 5,
          "maxLength": 300
        },
        "lat": {
          "type": "number",
          "description": "Pickup location latitude (-90 to 90)."
        },
        "lng": {
          "type": "number",
          "description": "Pickup location longitude (-180 to 180)."
        },
        "preferredDate": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "timeSlot": {
          "type": "string",
          "enum": [
            "09:00 AM - 12:00 PM",
            "10:00 AM - 01:00 PM",
            "02:00 PM - 05:00 PM",
            "05:00 PM - 08:00 PM"
          ],
          "maxLength": 32
        },
        "contactName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "contactPhone": {
          "type": "string",
          "minLength": 6,
          "maxLength": 40
        },
        "instructions": {
          "type": "string",
          "maxLength": 500
        },
        "status": {
          "type": "string",
          "enum": [
            "Submitted",
            "Under Review",
            "Approved",
            "Scheduled",
            "Transporter Assigned",
            "Collected",
            "Received at Facility",
            "Processing",
            "Completed",
            "Cancelled"
          ],
          "maxLength": 32
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "userId",
        "requestCode",
        "deviceName",
        "category",
        "quantity",
        "estimatedWeightKg",
        "condition",
        "pickupAddress",
        "lat",
        "lng",
        "preferredDate",
        "timeSlot",
        "contactName",
        "contactPhone",
        "instructions",
        "status",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/userPreferences/{userId}": {
      "schema": { "$ref": "#/entities/UserPreference" },
      "description": "Per-user UI preferences (theme, language, alerts)."
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/NotificationItem" },
      "description": "Real-time user notifications."
    },
    "/chatSessions/{sessionId}": {
      "schema": { "$ref": "#/entities/ChatSession" },
      "description": "EcoBot AI assistant chat histories."
    },
    "/admins/{adminUid}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Admin role membership records."
    },
    "/facilityReviews/{reviewId}": {
      "schema": { "$ref": "#/entities/FacilityReview" },
      "description": "Public community ratings and reviews for verified collection centres."
    },
    "/scheduledPickups/{bookingId}": {
      "schema": { "$ref": "#/entities/ScheduledPickup" },
      "description": "Authenticated user e-waste collection time-slot bookings (strict owner/admin PII access)."
    }
  }
}
