    "MonthlyRecyclingTarget": {
      "title": "MonthlyRecyclingTarget",
      "description": "User-defined monthly recycling goals (e-waste mass, CO2 avoided, and completed pickups) with milestone notification tracking.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "monthKey": {
          "type": "string",
          "minLength": 7,
          "maxLength": 7,
          "pattern": "^[0-9]{4}-[0-9]{2}$"
        },
        "targetWeightKg": {
          "type": "number",
          "description": "Monthly e-waste recycling weight target in kilograms (1 to 50000)."
        },
        "targetCo2Kg": {
          "type": "number",
          "description": "Monthly CO2e avoided target in kilograms (1 to 100000)."
        },
        "targetPickups": {
          "type": "integer",
          "description": "Monthly completed pickups or drop-offs target (1 to 500)."
        },
        "loggedBonusWeightKg": {
          "type": "number",
          "description": "Additional self-logged verified drop-off weight in kilograms (0 to 50000)."
        },
        "notifiedMilestones": {
          "type": "array",
          "description": "Bounded list of milestone IDs already notified for this month (max 12)."
        },
        "notes": {
          "type": "string",
          "maxLength": 300
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "userId",
        "monthKey",
        "targetWeightKg",
        "targetCo2Kg",
        "targetPickups",
        "loggedBonusWeightKg",
        "notifiedMilestones",
        "notes",
        "createdAt",
        "updatedAt"
      ]
    },
    "MarketplaceListing": {
      "title": "MarketplaceListing",
      "description": "Community listing for trading or donating functional electronic components salvaged from e-waste (zero PII; display name and city only).",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "title": {
          "type": "string",
          "minLength": 3,
          "maxLength": 120
        },
        "componentCategory": {
          "type": "string",
          "enum": [
            "Cables & Adapters",
            "Chargers & Power",
            "RAM & Storage",
            "Fans & Thermal",
            "Displays & Panels",
            "Peripherals",
            "Spare Parts & PCBs",
            "Networking & Audio"
          ],
          "maxLength": 40
        },
        "listingType": {
          "type": "string",
          "enum": ["Donate", "Trade"],
          "maxLength": 16
        },
        "condition": {
          "type": "string",
          "enum": ["Tested Working", "Like New", "Minor Wear", "For Parts / Repair"],
          "maxLength": 32
        },
        "quantity": {
          "type": "integer",
          "description": "Number of functional units available (1 to 500)."
        },
        "estimatedWeightKg": {
          "type": "number",
          "description": "Estimated component weight in kilograms (0.05 to 200)."
        },
        "salvagedFrom": {
          "type": "string",
          "maxLength": 100
        },
        "tradePreference": {
          "type": "string",
          "maxLength": 160
        },
        "description": {
          "type": "string",
          "minLength": 5,
          "maxLength": 600
        },
        "city": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "handoffMethod": {
          "type": "string",
          "enum": ["Local Pickup", "Facility Drop-off", "Community Meetup", "Courier"],
